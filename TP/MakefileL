CXX ?= g++
CXXFLAGS ?= -std=c++11 -Wall -Wextra -pedantic -O2
CPPFLAGS ?= -Iinclude
SOURCES := $(wildcard src/*.cpp)
OBJECTS := $(patsubst src/%.cpp,obj/%.o,$(SOURCES))
OUTPUT := bin/TP

.PHONY: all run clean

all: $(OUTPUT)

run: all
	./$(OUTPUT)

bin:
	mkdir -p bin

obj:
	mkdir -p obj

$(OUTPUT): $(OBJECTS) | bin
	$(CXX) $(OBJECTS) -o $(OUTPUT)

obj/%.o: src/%.cpp | obj
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS) $(OUTPUT)
